APP_ENV=dev                       # dev | prod  (prod 는 클러스터의 ConfigMap 에서만 지정)

# --- Postgres ---
POSTGRES_USER=app
POSTGRES_PASSWORD=                # openssl rand -hex 24  (URL에 들어가므로 hex 권장)
POSTGRES_DB=travel
# 호스트에서 uvicorn 직접 실행할 때 사용 (docker compose 안에서는 자동으로 덮어씀)
DATABASE_URL=postgres://app:<POSTGRES_PASSWORD>@127.0.0.1:5432/travel

# --- 앱 ---
SESSION_SECRET=                   # openssl rand -base64 32
PUBLIC_URL=https://trip.example.com   # 사용자가 접속하는 웹 주소 (web 도메인)
COOKIE_SECURE=true                # 로컬 http 개발에서는 false
DOCS_ENABLED=true                 # 운영에서는 false (/api/docs 비공개)

# --- Google 로그인 (OAuth 클라이언트) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 장소 검색 ---
GEOAPIFY_API_KEY=                 # 입력 중 제안(mode=suggest). 비어 있으면 suggest 는 503
NOMINATIM_USER_AGENT=travel-planner-api/0.1 (contact: you@example.com)
